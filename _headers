# En-têtes HTTP appliqués par Cloudflare Pages
# (ce fichier est ignoré par un simple serveur local et par GitHub Pages)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Les rapports PDF doivent s'ouvrir dans le navigateur et être téléchargeables
/assets/rapports/*
  Content-Type: application/pdf
  Content-Disposition: inline
  Cache-Control: public, max-age=3600

# Ressources versionnées : mises en cache longue
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=604800

/assets/css/*
  Cache-Control: public, max-age=3600

/assets/js/*
  Cache-Control: public, max-age=3600
